{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-vault-exists",
    "allow-backup-exists",
    "allow-is-unlocked",
    "allow-create-vault",
    "allow-unlock",
    "allow-lock",
    "allow-list-entries",
    "allow-get-password",
    "allow-get-entry",
    "allow-add-entry",
    "allow-update-entry",
    "allow-delete-entry",
    "allow-generate-password",
    "allow-score-password",
    "allow-change-master-password",
    "allow-copy-password",
    "allow-copy-username",
    "allow-copy-generated-password",
    "allow-restore-from-backup",
    "allow-export-vault",
    "dialog:allow-save",
    "core:app:default"
  ]
}
