{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-vault-exists",
    "allow-backup-exists",
    "allow-is-unlocked",
    "allow-create-vault",
    "allow-unlock",
    "allow-lock",
    "allow-list-entries",
    "allow-get-password",
    "allow-get-entry",
    "allow-add-entry",
    "allow-update-entry",
    "allow-delete-entry",
    "allow-generate-password",
    "allow-generate-passphrase",
    "allow-score-password",
